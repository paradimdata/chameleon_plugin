.g-oauth-provider-list-title
  margin 10px 0
  font-size 16px
  color #555
  border-bottom 1px solid #eee

.g-oauth-value-container
  margin 10px 0
  padding 3px 9px
  border 1px solid #ddd
  background-color #f6f6f6

  .g-oauth-value
    display inline-block
    margin-left 15px
    font-family monospace

.g-reg-policy-config-container
  border-radius 3px
  padding 15px 15px 5px
  border 1px solid #e2e2e2
  background-color #f7f7f7
  margin-bottom 30px

// === Added Styles for Gear Button ===

.g-config-gear-button-container
  text-align right
  margin 10px 0

.g-config-gear-button
  padding 6px 12px
  font-size 14px
  color #333
  background-color #f9f9f9
  border 1px solid #ccc
  border-radius 4px
  cursor pointer
  transition background-color 0.2s ease

  &:hover
    background-color #e6e6e6

  i
    margin-right 5px