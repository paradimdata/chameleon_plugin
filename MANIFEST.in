prune girder_chameleon/web_client
include girder_chameleon/web_client/dist/girder-plugin-chameleon.umd.cjs
include girder_chameleon/web_client/dist/style.css
prune girder_chameleon/tests
exclude girder_chameleon/tests
global-prune *.yaml
global-exclude *.yaml
prune scripts
exclude scripts
exclude codecov.yml MANIFEST.in requirements-dev.txt tox.ini
prune codecov.yml MANIFEST.in requirements-dev.txt tox.ini
include chameleon.png README.md
